{
  "name": "charcheck",
  "version": "0.4.1",
  "description": "Flag banned characters (em dashes, invisibles) in targeted parts of a repo, from one config",
  "keywords": [
    "banned-characters",
    "em-dash",
    "lint",
    "prose",
    "pre-commit",
    "commit-msg"
  ],
  "author": "shbernal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/charcheck.git"
  },
  "homepage": "https://github.com/shbernal/charcheck#readme",
  "bugs": {
    "url": "https://github.com/shbernal/charcheck/issues"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "charcheck": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings 0",
    "knip": "knip",
    "format": "oxfmt --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint:chars": "node dist/cli.js",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run knip && pnpm run format && pnpm run test && pnpm run build && pnpm run lint:chars",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.17"
  },
  "peerDependencies": {
    "@vue/compiler-sfc": "^3.5.0",
    "micromark": "^4.0.0",
    "parse5": "^8.0.0",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "@vue/compiler-sfc": {
      "optional": true
    },
    "micromark": {
      "optional": true
    },
    "parse5": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/compiler-sfc": "^3.5.45",
    "knip": "^6.45.0",
    "micromark": "^4.0.3",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "parse5": "^8.1.1",
    "typescript": "^6.0.3",
    "typescript-floor": "npm:typescript@5.9.3",
    "typescript-next": "npm:typescript@7.0.2",
    "vitest": "^5.1.0"
  }
}
