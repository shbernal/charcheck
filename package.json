{
  "name": "charcheck",
  "version": "0.2.5",
  "description": "Flag banned characters (em dashes, invisibles) in targeted parts of a repo, from one config",
  "keywords": [
    "banned-characters",
    "em-dash",
    "lint",
    "prose",
    "pre-commit",
    "commit-msg"
  ],
  "author": "shbernal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/charcheck.git"
  },
  "homepage": "https://github.com/shbernal/charcheck#readme",
  "bugs": {
    "url": "https://github.com/shbernal/charcheck/issues"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "charcheck": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings 0",
    "format": "oxfmt --check",
    "test": "vitest run",
    "lint:chars": "node dist/cli.js",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format && pnpm run test && pnpm run build && pnpm run lint:chars",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.15"
  },
  "peerDependencies": {
    "@vue/compiler-sfc": "^3.5.0",
    "micromark": "^4.0.0",
    "parse5": "^8.0.0",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "@vue/compiler-sfc": {
      "optional": true
    },
    "micromark": {
      "optional": true
    },
    "parse5": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vue/compiler-sfc": "^3.5.24",
    "micromark": "^4.0.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "parse5": "^8.0.1",
    "typescript": "^6.0.3",
    "typescript-next": "npm:typescript@7.0.2",
    "vitest": "^4.1.10"
  }
}
